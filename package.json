{
  "name": "@miorin/dsh-ios-top-clearance",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Keeps the phone Web UI header out of the iOS Home Screen app's scroll-edge blur band.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "ios"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "src",
    "scripts",
    "tsconfig.json"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "test": "npm run build && npm run test:unit --",
    "test:unit": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node scripts/build.mjs --check && npm run test:unit && npm run typecheck && node scripts/sync-types.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
